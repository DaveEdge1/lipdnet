extends layout

block css
	link(rel='stylesheet' href='css/index.css')
	link(rel="stylesheet" href="lib/angular-accordion/css/ang-accordion.css")
	link(rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons")

block body
	include ./include/navbar.jade

	// add #bg-img to body for photo background
	body(ng-app='indexApp' ng-controller="IndexCtrl")
		#wrapper
			section#content(ng-cloak)
				.container#intro.text-center
					div
						h1.md-display-3 { Linked Paleo Data }
						img(ng-src="img/logo_trans.png" width="180px" style="margin: 10px 0 14px;")
						p.md-subhead LiPD (Linked PaleoData) is an open data standard for sharing, reusing, and analyzing paleoclimate datasets. Each LiPD file packages tabular proxy data alongside rich structured metadata in a portable, validated archive — letting scientists spend less time managing data and more time doing science.
						p.md-subhead LiPD is supported by libraries for R (lipdR) and Python (pylipd), a browser-based editor (LiPD Studio), an editor extension for VS Code, and a growing community archive at LiPDverse that is also published as a queryable knowledge graph.
						p.md-subhead.
							A technical description of the format for developers is available on the
							#[a(href='/format') Format page.]


			//#buttons(layout='row')
			//	//- .md-button.schematic-btn.left(ng-mouseenter="sch=true" ng-mouseleave="sch=false") Schematic
			//	a.right.smoothScroll(href="#schematic")
			//		i.fa.fa-angle-double-down.fa-5x
			
		.container.cf#schematic
			.animation-element.bounce-up.cf
				h1.subject.md-display-3(layout layout-align="center center") Dataset Structure
				.subject.third
					.content(layout='row' layout-align='space-around center' ng-cloak)
						img(ng-src="img/schematic_v1_3.png" style='width:100%;')


		.container.cf#gettingstarted
			.animation-element.bounce-up.cf
				h1.subject.md-display-3 Getting Started
				.subject.first
					.category-color
					.icon
						i.fa.fa-rocket
					.header.cf
					.content
						.gs-subsection
							.gs-subsection-header
								i.fa.fa-code.gs-icon
								h3 Software
							p.gs-subsection-intro LiPD is supported by libraries for R and Python, a browser-based editor, and an editor extension for VS Code. Choose what fits your workflow.
							.row
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline lipdR
												span.md-subhead R package
										md-card-content
											p Read, write, and validate LiPD files in R. Works seamlessly with data frames and the tidyverse.
											pre.gs-install-code install.packages("lipdR")
									md-card-actions(layout="row")
										a.md-button(href="https://github.com/nickmckay/lipdR" target="_blank")
											i.fa.fa-github
											|  GitHub
										a.md-button(href="https://nickmckay.github.io/lipdR/" target="_blank") Docs
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline pylipd
												span.md-subhead Python package
										md-card-content
											p Read, write, and validate LiPD files in Python. Integrates with pandas, NumPy, and Pyleoclim.
											pre.gs-install-code pip install pylipd
									md-card-actions(layout="row")
										a.md-button(href="https://github.com/LinkedEarth/pylipd" target="_blank")
											i.fa.fa-github
											|  GitHub
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline LiPD Playground
												span.md-subhead Browser-based editor
										md-card-content
											p Create, upload, and edit LiPD files directly in your browser. No installation required.
									md-card-actions(layout="row")
										a.md-button.md-raised.md-primary(href="/playground") Open Playground
							.row
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline LiPD File Support
												span.md-subhead VS Code extension
										md-card-content
											p Open and edit LiPD files in VS Code or Cursor, with form-based editing, a site map, and CSV export. Its GraphDB explorer browses the LiPD Graph and opens remote datasets straight from the editor.
									md-card-actions(layout="row")
										a.md-button.md-raised.md-primary(href="https://marketplace.visualstudio.com/items?itemName=karyalimited.lipd-vscode" target="_blank") Install
										a.md-button(href="https://github.com/LinkedEarth/lipd-vscode" target="_blank")
											i.fa.fa-github
											|  GitHub
						.gs-subsection
							.gs-subsection-header
								i.fa.fa-database.gs-icon
								h3 Find Data
							.gs-feature-block
								.gs-feature-body
									h4
										a(href="https://lipdverse.org/" target="_blank") LiPDverse
									p The community archive for LiPD datasets. Browse thousands of paleoclimate records by archive type, variable, region, and age range. Download individual files or entire collections.
									a.md-button.md-raised(href="https://lipdverse.org/" target="_blank")
										i.fa.fa-external-link
										|  Visit LiPDverse
							.gs-feature-block
								.gs-feature-body
									h4 LiPD Graph
									p Every dataset in LiPDverse is also published as linked data in a knowledge graph, so you can ask questions across the whole archive at once rather than opening files one at a time — every marine sediment record between two latitudes with a Mg/Ca column, say. The graph is a SPARQL endpoint, and the Query page runs against it directly in your browser.
									p To browse it interactively, the LiPD File Support extension for VS Code includes a GraphDB explorer that searches the graph by name, location, or time period and opens a remote dataset straight in the editor.
									a.md-button.md-raised.md-primary(href="/query") Query the Graph
									a.md-button(href="https://marketplace.visualstudio.com/items?itemName=karyalimited.lipd-vscode" target="_blank")
										i.fa.fa-external-link
										|  Browse it in VS Code
						.gs-subsection
							.gs-subsection-header
								i.fa.fa-pencil.gs-icon
								h3 Create and Edit Files
							.gs-feature-block
								.gs-feature-body
									h4
										a(href="/playground") LiPD Playground
									p The Playground provides a structured form editor for all LiPD metadata fields, built-in validation feedback, CSV data entry, and one-click download of the finished file.
									p For programmatic or batch creation, use lipdR or pylipd to build LiPD objects from data frames or dictionaries and write them to disk.
									a.md-button.md-raised.md-primary(href="/playground") Open Playground
						.gs-subsection
							.gs-subsection-header
								i.fa.fa-line-chart.gs-icon
								h3 Analyze Data
							p.gs-subsection-intro Once you have data loaded via lipdR or pylipd, these packages extend your analysis capabilities.
							.row
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline GeoChronR
												span.md-subhead R package
										md-card-content
											p Age modeling, time series analysis, and visualization for paleoclimate data. Integrates Bchron, Bacon, and other age models.
									md-card-actions(layout="row")
										a.md-button(href="https://nickmckay.github.io/GeoChronR/" target="_blank")
											i.fa.fa-github
											|  GitHub
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline actR
												span.md-subhead R package
										md-card-content
											p Abrupt change detection and climate reconstruction with rigorous uncertainty quantification.
									md-card-actions(layout="row")
										a.md-button(href="https://github.com/nickmckay/actR" target="_blank")
											i.fa.fa-github
											|  GitHub
								.col-md-4
									md-card.gs-tool-card
										md-card-title
											md-card-title-text
												span.md-headline Pyleoclim
												span.md-subhead Python package
										md-card-content
											p Spectral analysis, wavelet transforms, mapping, and visualization for paleoclimate time series.
									md-card-actions(layout="row")
										a.md-button(href="https://github.com/LinkedEarth/Pyleoclim_util" target="_blank")
											i.fa.fa-github
											|  GitHub


		.container.cf#faq
			.animation-element.bounce-up.cf
				h1.subject.md-display-3 FAQ
				.subject.first
					.category-color
					.icon
						i.fa.fa-question
					.header.cf
					.content
						//h1.subject.md-display-3(layout layout-align="center center") FAQ
						ang-accordion
							collapsible-item(ng-repeat="item in faqs" item-title="{{item.question}}")
								div
									p {{item.answer}}


		.container.cf#quicklinks
			.animation-element.bounce-up.cf
				h1.subject.md-display-3 Quick Links
				.subject.first
					.category-color
					.icon
						i.fa.fa-link
					.header.cf
					.content
						md-button(ng-repeat="item in quickLinks" style="background-color: #f6f6f6; min-width: 204px; min-height:118px;" ng-href="{{item.link}}")
							br
							i.material-icons.md-dark.md-36 {{item.icon}}
							//i(class = "{{item.icon}}")
							br
							span {{item.title}}
							md-tooltip {{item.tooltip}}

	.container.cf#about
			.animation-element.bounce-up.cf
				h1.subject.md-display-3(layout layout-align="center center") About Us
				.subject.first
					.category-color
					.icon
						i.fa.fa-users
					.header.cf
					//h3.title Team
					.content(layout-sm='column' layout='row' layout-align='space-around center')
						.layout-margin(flex='25')
							md-card
								img.md-card-image(ng-src="img/emile.jpg")
								md-card-content
									h2.md-title Julien Emile-Geay
									p Principal Investigator
									p Department of Earth Science
									p University of Southern California
						.layout-margin(flex='25')
							md-card
								img.md-card-image(ng-src="img/mckay.jpg")
								md-card-content
									h2.md-title Nicholas McKay
									p Principal Investigator
									p School of Earth Sciences and Environmental Sustainability
									p Northern Arizona University
						.layout-margin(flex='25')
							md-card
								img.md-card-image(ng-src="img/khider.jpg")
								md-card-content
									div(layout='row' layout-align='space-around center')
									h2.md-title Deborah Khider
									p Department of Earth Science
									p University of Southern California

				//.subject.second
				//	.category-color
				//	.icon
				//		i.fa.fa-globe
				//	.header.cf
				//	h3.title Location
				//	.content
				//		div(ng-controller='MapCtrl' ng-cloak)
				//			ui-gmap-google-map(center="map.center" zoom="map.zoom" options="options")

		footer
			p#nsf.
				The development of LiPD is funded by the National Science Foundation
				#[img(ng-src='img/nsf.jpg' style='width:50px')]


block js
	script(src="lib/angular-accordion/js/ang-accordion.js")
	script(src="https://cdnjs.cloudflare.com/ajax/libs/angular-sanitize/1.4.9/angular-sanitize.min.js")
	script(src='https://cdnjs.cloudflare.com/ajax/libs/angular-google-maps/2.2.0/angular-google-maps.min.js')
	script(src='https://maps.googleapis.com/maps/api/js?sensor=false')
	script(src='apps/indexApp.js')
	script(src='js/ngMap.js')
	script(src="js/ngIndex.js")
	script(src="js/ngContact.js")
	script(src='lib/animate.js')
	script(src='lib/smooth.js')
	// Default Statcounter code for LiPD http://www.lipd.net
	script(type="text/javascript").
		var sc_project = 11832646;
		var sc_invisible = 1;
		var sc_security = "8be7df0d";
		var sc_https = 1;
		var sc_remove_link = 1;
	script(type="text/javascript", src="https://www.statcounter.com/counter/counter.js", async="")
	noscript
		.statcounter
			img.statcounter(src="//c.statcounter.com/11832646/0/8be7df0d/1/", alt="Web Analytics")
