	//- Beta announcement popup: show once until the user opts to stay on classic.
	script(type="text/javascript").
		(function(){
			try {
				var KEY = 'lipd-beta-playground-dismissed';
				var backdrop = document.getElementById('beta-modal-backdrop');
				if (!backdrop) return;
				var dismissed = false;
				try { dismissed = !!localStorage.getItem(KEY); } catch (e) {}
				if (!dismissed) backdrop.style.display = 'block';
				function hide(){
					backdrop.style.display = 'none';
					try { localStorage.setItem(KEY, '1'); } catch (e) {}
				}
				var dismiss = document.getElementById('beta-modal-dismiss');
				if (dismiss) dismiss.addEventListener('click', function(e){ e.preventDefault(); hide(); });
				backdrop.addEventListener('click', function(e){ if (e.target === backdrop) hide(); });
			} catch (e) {}
		})();
